<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dank Franks — Portfolio</title>
  
  <!-- Font Awesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Lottie Player Web Component -->
  <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>

  <style>
    /* ==========================================================================
       1. BASE & RESET STYLES
       ========================================================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #0d0d0d;
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    img, video {
      max-width: 100%;
      height: auto;
      display: block;
    }

    /* ==========================================================================
       2. HEADER & NAVIGATION
       ========================================================================== */
    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(13, 13, 13, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #222;
    }
    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .logo img {
      height: 32px;
      width: auto;
    }
    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1.2px;
    }
    .nav-links a:hover {
      color: #ff5500;
      transition: color 0.2s ease;
    }
    .social-links {
      display: flex;
      gap: 1rem;
      font-size: 1.1rem;
    }
    .social-links a:hover {
      color: #ff5500;
    }

    /* ==========================================================================
       3. HERO SECTION
       ========================================================================== */
    .hero-section {
      position: relative;
      min-height: 75vh;
      /* RELINK BACKGROUND: Replace placeholder with your background image URL */
      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.7)), 
                  url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 1.5rem 2rem 1.5rem;
    }
    .hero-content {
      position: relative;
      text-align: center;
      max-width: 650px;
      width: 100%;
      padding: 3rem 2rem 2rem 2rem;
      background: rgba(18, 18, 18, 0.85);
      border: 1px solid #333;
      border-radius: 12px;
      backdrop-filter: blur(8px);
    }
    .hero-avatar {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      border: 3px solid #ffffff;
      position: absolute;
      top: -45px;
      left: 50%;
      transform: translateX(-50%);
      object-fit: cover;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }
    .quote-icon {
      color: #ff5500;
      font-size: 1.6rem;
      margin-bottom: 0.8rem;
    }
    .hero-content h1 {
      font-size: 1.75rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .hero-content p {
      color: #ccc;
      font-size: 0.95rem;
    }

    /* ==========================================================================
       4. PORTFOLIO CARDS GRID
       ========================================================================== */
    .portfolio-grid-section {
      padding: 4rem 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1.25rem;
    }
    .card {
      background: #141414;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #222;
      transition: transform 0.3s ease, border-color 0.3s ease;
      text-align: center;
      padding-bottom: 1.25rem;
    }
    .card:hover {
      transform: translateY(-5px);
      border-color: #d48344;
    }
    .card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
    }
    .card h3 {
      font-size: 1rem;
      margin-top: 1rem;
      padding: 0 0.5rem;
    }
    .card p {
      font-size: 0.8rem;
      color: #888;
      margin-top: 0.25rem;
    }

    /* ==========================================================================
       5. FEATURED BANNER
       ========================================================================== */
    .featured-banner {
      text-align: center;
      padding: 3.5rem 1.5rem;
      background: #111111;
      border-top: 1px solid #222;
      border-bottom: 1px solid #222;
    }
    .featured-banner h2 {
      font-size: 2.2rem;
      font-weight: 800;
      letter-spacing: 2px;
      font-family: Georgia, serif;
    }
    .featured-banner p {
      color: #888;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-top: 0.5rem;
    }

    /* ==========================================================================
       6. GRAPHIC ARTWORK & FLOATING STROKE BOXES
       ========================================================================== */
    .graphic-section {
      position: relative;
      min-height: 850px;
      /* RELINK BACKGROUND: Replace placeholder with abstract graphic artwork */
      background: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.5)),
                  url('https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
      padding: 4rem 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-around;
    }
    .stroke-box {
      position: absolute;
      background: rgba(10, 10, 10, 0.88);
      border: 1px solid #d48344;
      border-radius: 6px;
      padding: 1.25rem;
      max-width: 320px;
      font-size: 0.85rem;
      backdrop-filter: blur(4px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.6);
    }
    .stroke-box h4 {
      margin-bottom: 0.5rem;
      color: #ffffff;
      font-size: 0.95rem;
    }
    .stroke-box p {
      color: #bbb;
      font-size: 0.825rem;
    }

    /* Absolute Placement for Desktop */
    .box-1 { top: 10%; left: 15%; }
    .box-2 { top: 28%; right: 15%; }
    .box-3 { top: 52%; left: 18%; }
    .box-4 { top: 72%; right: 18%; }

    /* ==========================================================================
       7. LOTTIE JSON ICON GRID
       ========================================================================== */
    .lottie-section {
      padding: 4rem 1.5rem;
      background: #050505;
      text-align: center;
      border-bottom: 1px solid #1f1f1f;
    }
    .lottie-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 1.5rem;
      max-width: 1000px;
      margin: 0 auto;
    }
    .lottie-card {
      display: flex;
      justify-content: center;
      align-items: center;
      background: #111111;
      padding: 1.5rem;
      border-radius: 8px;
      border: 1px solid #222;
    }

    /* ==========================================================================
       8. REVIEWS REPEATER
       ========================================================================== */
    .reviews-section {
      padding: 5rem 1.5rem;
      text-align: center;
      background: #0d0d0d;
    }
    .reviews-section h2 {
      margin-bottom: 3rem;
      font-weight: 300;
      letter-spacing: 1px;
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1.5rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .review-card {
      text-align: center;
      background: #121212;
      padding: 1.5rem 1rem;
      border-radius: 8px;
      border: 1px solid #1f1f1f;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .review-card i {
      color: #6366f1;
      margin-bottom: 0.75rem;
      font-size: 1.1rem;
    }
    .review-card p {
      color: #bbb;
      font-size: 0.825rem;
      margin-bottom: 1.25rem;
    }
    .review-card .author {
      font-weight: bold;
      color: #fff;
      font-size: 0.85rem;
    }
    .review-card .title {
      color: #666;
      font-size: 0.75rem;
    }

    /* ==========================================================================
       9. VIDEO SECTION
       ========================================================================== */
    .video-section {
      position: relative;
      width: 100%;
      background: #000;
      display: flex;
      justify-content: center;
      padding: 2rem 0;
    }
    .video-section video {
      width: 100%;
      max-width: 1000px;
      border-radius: 8px;
    }

    /* ==========================================================================
       10. FOOTER & SCROLL TOP
       ========================================================================== */
    footer {
      background: #050505;
      padding: 2.5rem 1.5rem;
      text-align: center;
      border-top: 1px solid #1a1a1a;
      font-size: 0.8rem;
      color: #666;
    }
    footer a {
      color: #aaa;
    }
    footer a:hover {
      color: #fff;
    }
    .back-to-top {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: rgba(30, 30, 30, 0.8);
      border: 1px solid #444;
      color: #fff;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      backdrop-filter: blur(5px);
      transition: background 0.3s, transform 0.2s;
      z-index: 99;
    }
    .back-to-top:hover {
      background: #ff5500;
      border-color: #ff5500;
      transform: translateY(-2px);
    }

    /* ==========================================================================
       11. RESPONSIVE BREAKPOINTS (TABLET & MOBILE)
       ========================================================================== */

    /* TABLET RESPONSIVE (Max width: 1023px) */
    @media (max-width: 1023px) {
      .portfolio-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      .reviews-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      
      /* Switch floating text boxes to layout flow on tablet */
      .graphic-section {
        min-height: auto;
        padding: 4rem 2rem;
        gap: 1.5rem;
      }
      .stroke-box {
        position: relative;
        top: auto !important;
        left: auto !important;
        right: auto !important;
        max-width: 100%;
        width: 100%;
      }
    }

    /* MOBILE RESPONSIVE (Max width: 767px) */
    @media (max-width: 767px) {
      .nav-container {
        flex-direction: column;
        gap: 1rem;
      }
      .nav-links {
        gap: 1rem;
        font-size: 0.75rem;
      }
      .portfolio-grid {
        grid-template-columns: repeat(1, 1fr);
      }
      .reviews-grid {
        grid-template-columns: repeat(1, 1fr);
      }
      .hero-section {
        padding-top: 5rem;
      }
      .hero-content h1 {
        font-size: 1.35rem;
      }
      .hero-content p {
        font-size: 0.85rem;
      }
      .featured-banner h2 {
        font-size: 1.6rem;
      }
      .lottie-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .back-to-top {
        bottom: 1.25rem;
        right: 1.25rem;
        width: 38px;
        height: 38px;
      }
    }
  </style>
</head>
